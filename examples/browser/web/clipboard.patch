 #[cfg(target_arch = "wasm32")]
 mod platform {
     use super::*;
 
-    /// A buffer for short-term storage and transfer within and between
-    /// applications.
+    use wasm_bindgen_futures::{JsFuture, spawn_local};
+
+    /// Access to the browser clipboard in a secure context.
     pub struct Clipboard;
 
+    fn browser_clipboard() -> Result<web_sys::Clipboard, Error> {
+        web_sys::window()
+            .map(|window| window.navigator().clipboard())
+            .filter(|clipboard| !clipboard.is_null_or_undefined())
+            .ok_or(Error::ClipboardUnavailable)
+    }
+
     impl Clipboard {
-        /// Creates a new [`Clipboard`] for the given window.
+        /// Creates a new clipboard for the current browser window.
         pub fn new() -> Self {
             Self
         }
 
-        /// Reads the current content of the [`Clipboard`] as text.
-        pub fn read(&self, _kind: Kind, callback: impl FnOnce(Result<Content, Error>)) {
-            callback(Err(Error::ClipboardUnavailable));
-        }
-
-        /// Writes the given text contents to the [`Clipboard`].
-        pub fn write(&mut self, _content: Content, callback: impl FnOnce(Result<(), Error>)) {
-            callback(Err(Error::ClipboardUnavailable));
+        /// Reads plain text and reports permission or conversion errors to iced.
+        pub fn read(&self, kind: Kind, callback: impl FnOnce(Result<Content, Error>) + 'static) {
+            let Kind::Text = kind else {
+                callback(Err(Error::ContentNotAvailable));
+                return;
+            };
+            let Ok(clipboard) = browser_clipboard() else {
+                callback(Err(Error::ClipboardUnavailable));
+                return;
+            };
+            let read = clipboard.read_text();
+            spawn_local(async move {
+                callback(
+                    JsFuture::from(read)
+                        .await
+                        .map_err(|_| Error::ClipboardUnavailable)
+                        .and_then(|value| {
+                            value
+                                .as_string()
+                                .map(Content::Text)
+                                .ok_or(Error::ConversionFailure)
+                        }),
+                );
+            });
+        }
+
+        /// Starts the write during the input event and acknowledges it when the browser settles it.
+        pub fn write(
+            &mut self,
+            content: Content,
+            callback: impl FnOnce(Result<(), Error>) + 'static,
+        ) {
+            let Content::Text(text) = content else {
+                callback(Err(Error::ContentNotAvailable));
+                return;
+            };
+            let Ok(clipboard) = browser_clipboard() else {
+                callback(Err(Error::ClipboardUnavailable));
+                return;
+            };
+            let write = clipboard.write_text(&text);
+            spawn_local(async move {
+                callback(
+                    JsFuture::from(write)
+                        .await
+                        .map(|_| ())
+                        .map_err(|_| Error::ClipboardUnavailable),
+                );
+            });
         }
     }
 }
