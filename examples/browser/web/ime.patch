+//! DOM input methods for the canvas backend, owned by the iced window.
+
+use std::cell::{Cell, RefCell};
+use std::rc::Rc;
+
+use web_sys::wasm_bindgen::{JsCast, JsValue, closure::Closure};
+use web_sys::{
+    Event, EventTarget, FocusEvent, FocusOptions, HtmlCanvasElement, HtmlInputElement, InputEvent,
+    KeyboardEvent, KeyboardEventInit,
+};
+
+use crate::core::{Rectangle, input_method};
+
+thread_local! {
+    static GESTURE: Cell<bool> = const { Cell::new(false) };
+}
+
+/// Settle the UI and its IME request before returning to the DOM gesture handler.
+pub fn gesture(f: impl FnOnce()) {
+    struct Restore(bool);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            GESTURE.set(self.0);
+        }
+    }
+    let _restore = Restore(GESTURE.replace(true));
+    f();
+}
+
+struct Listener {
+    target: EventTarget,
+    name: &'static str,
+    callback: Closure<dyn FnMut(Event)>,
+}
+
+impl Listener {
+    fn new(
+        target: &EventTarget,
+        name: &'static str,
+        handler: impl FnMut(Event) + 'static,
+    ) -> Result<Self, JsValue> {
+        let callback = Closure::wrap(Box::new(handler) as Box<dyn FnMut(Event)>);
+        target.add_event_listener_with_callback_and_bool(
+            name,
+            callback.as_ref().unchecked_ref(),
+            true,
+        )?;
+        Ok(Self {
+            target: target.clone(),
+            name,
+            callback,
+        })
+    }
+}
+
+impl Drop for Listener {
+    fn drop(&mut self) {
+        let _ = self.target.remove_event_listener_with_callback_and_bool(
+            self.name,
+            self.callback.as_ref().unchecked_ref(),
+            true,
+        );
+    }
+}
+
+pub struct Input {
+    element: HtmlInputElement,
+    canvas: HtmlCanvasElement,
+    enabled: bool,
+    listeners: Vec<Listener>,
+}
+
+// A sentinel lets mobile keyboards produce deletion events even though iced owns
+// the text and selection. It is never committed to the application.
+const SENTINEL: &str = "\u{200b}";
+
+impl Input {
+    pub fn new(
+        canvas: HtmlCanvasElement,
+        emit: impl Fn(input_method::Event) + 'static,
+    ) -> Result<Self, JsValue> {
+        let document = canvas
+            .owner_document()
+            .ok_or_else(|| JsValue::from_str("Missing document"))?;
+        let element: HtmlInputElement = document.create_element("input")?.dyn_into()?;
+        element.set_attribute("data-iced-ime", "")?;
+        element.set_attribute("aria-label", "Text input")?;
+        element.set_attribute("autocomplete", "off")?;
+        element.set_attribute("autocorrect", "off")?;
+        element.set_attribute("autocapitalize", "off")?;
+        element.set_attribute("spellcheck", "false")?;
+        element.set_attribute("tabindex", "-1")?;
+        element.set_attribute("style", "position:fixed;width:1px;height:1px;padding:0;border:0;opacity:0;pointer-events:none;font-size:16px;resize:none;overflow:hidden;")?;
+        reset(&element);
+        document
+            .body()
+            .ok_or_else(|| JsValue::from_str("Missing document body"))?
+            .append_child(&element)?;
+
+        let emit: Rc<dyn Fn(input_method::Event)> = Rc::new(emit);
+        let composing = Rc::new(Cell::new(false));
+        let committed = Rc::new(RefCell::new(None::<String>));
+        let mut input = Self {
+            element,
+            canvas,
+            enabled: false,
+            listeners: Vec::new(),
+        };
+
+        // Canvas and input are one window: moving between them is not a
+        // window blur. Capture runs before winit's canvas focus listeners.
+        let element = input.element.clone();
+        input.listeners.push(Listener::new(
+            input.canvas.as_ref(),
+            "blur",
+            move |event| {
+                let event: &FocusEvent = event.unchecked_ref();
+                if event.related_target().as_ref() == Some(element.as_ref()) {
+                    event.stop_immediate_propagation();
+                }
+            },
+        )?);
+        for name in ["focus", "blur"] {
+            let canvas = input.canvas.clone();
+            input
+                .listeners
+                .push(Listener::new(input.element.as_ref(), name, move |event| {
+                    let event: &FocusEvent = event.unchecked_ref();
+                    if event.related_target().as_ref() != Some(canvas.as_ref()) {
+                        if let Ok(forwarded) = FocusEvent::new(name) {
+                            let _ = canvas.dispatch_event(&forwarded);
+                        }
+                    }
+                })?);
+        }
+
+        for name in ["keydown", "keyup"] {
+            let canvas = input.canvas.clone();
+            let committed = committed.clone();
+            input
+                .listeners
+                .push(Listener::new(input.element.as_ref(), name, move |event| {
+                    let event: &KeyboardEvent = event.unchecked_ref();
+                    // Text comes from input/composition, never both KeyboardInput
+                    // and IME Commit. Navigation and application shortcuts keep the
+                    // normal winit path, including iced's own selection semantics.
+                    let key = event.key();
+                    if event.is_composing()
+                        || matches!(key.as_str(), "Process" | "Unidentified" | "Dead")
+                    {
+                        return;
+                    }
+                    if name == "keydown" {
+                        committed.borrow_mut().take();
+                    }
+                    if event.ctrl_key() || event.meta_key() || key.chars().count() != 1 {
+                        let init = KeyboardEventInit::new();
+                        init.set_key(&key);
+                        init.set_code(&event.code());
+                        init.set_location(event.location());
+                        init.set_repeat(event.repeat());
+                        init.set_ctrl_key(event.ctrl_key());
+                        init.set_meta_key(event.meta_key());
+                        init.set_alt_key(event.alt_key());
+                        init.set_shift_key(event.shift_key());
+                        if let Ok(forwarded) =
+                            KeyboardEvent::new_with_keyboard_event_init_dict(name, &init)
+                        {
+                            let _ = canvas.dispatch_event(&forwarded);
+                        }
+                        event.prevent_default();
+                    }
+                })?);
+        }
+
+        let canvas = input.canvas.clone();
+        let element = input.element.clone();
+        let is_composing = composing.clone();
+        let pending = committed.clone();
+        input.listeners.push(Listener::new(
+            input.element.as_ref(),
+            "beforeinput",
+            move |event| {
+                let event: &InputEvent = event.unchecked_ref();
+                if is_composing.get() || event.is_composing() {
+                    return;
+                }
+                let kind = event.input_type();
+                if !kind.is_empty() && !kind.contains("Composition") {
+                    pending.borrow_mut().take();
+                }
+                let key = match kind.as_str() {
+                    "deleteContentBackward" => Some("Backspace"),
+                    "deleteContentForward" => Some("Delete"),
+                    "insertLineBreak" | "insertParagraph" => Some("Enter"),
+                    _ => None,
+                };
+                if let Some(key) = key {
+                    keypress(&canvas, key);
+                    event.prevent_default();
+                    reset(&element);
+                }
+            },
+        )?);
+
+        let element = input.element.clone();
+        let is_composing = composing.clone();
+        let emit_text = emit.clone();
+        let pending = committed.clone();
+        input.listeners.push(Listener::new(
+            input.element.as_ref(),
+            "input",
+            move |event| {
+                let event: &InputEvent = event.unchecked_ref();
+                if is_composing.get() || event.is_composing() {
+                    return;
+                }
+                if event.input_type().contains("Composition") {
+                    reset(&element);
+                    return;
+                }
+                // Ignore the post-composition input event: compositionend already
+                // committed it and reset the input to its sentinel.
+                let value = element.value();
+                let text = value.strip_prefix(SENTINEL).unwrap_or(&value);
+                let duplicate = pending.borrow_mut().take().as_deref() == Some(text);
+                if !text.is_empty() && !duplicate {
+                    emit_text(input_method::Event::Commit(text.to_owned()));
+                }
+                reset(&element);
+            },
+        )?);
+
+        let is_composing = composing.clone();
+        let emit_start = emit.clone();
+        input.listeners.push(Listener::new(
+            input.element.as_ref(),
+            "compositionstart",
+            move |_| {
+                is_composing.set(true);
+                emit_start(input_method::Event::Opened);
+            },
+        )?);
+        let emit_update = emit.clone();
+        input.listeners.push(Listener::new(
+            input.element.as_ref(),
+            "compositionupdate",
+            move |event| {
+                let event: &web_sys::CompositionEvent = event.unchecked_ref();
+                let text = event.data().unwrap_or_default();
+                let end = text.len();
+                emit_update(input_method::Event::Preedit(text, Some(end..end)));
+            },
+        )?);
+        let element = input.element.clone();
+        input.listeners.push(Listener::new(
+            input.element.as_ref(),
+            "compositionend",
+            move |event| {
+                let event: &web_sys::CompositionEvent = event.unchecked_ref();
+                composing.set(false);
+                emit(input_method::Event::Preedit(String::new(), None));
+                if let Some(text) = event.data().filter(|text| !text.is_empty()) {
+                    *committed.borrow_mut() = Some(text.clone());
+                    emit(input_method::Event::Commit(text));
+                }
+                emit(input_method::Event::Closed);
+                reset(&element);
+            },
+        )?);
+        Ok(input)
+    }
+
+    pub fn enable(&mut self, cursor: Rectangle, purpose: input_method::Purpose) {
+        self.enabled = true;
+        let bounds = self.canvas.get_bounding_client_rect();
+        let style = self.element.style();
+        let _ = style.set_property("left", &format!("{}px", bounds.x() + f64::from(cursor.x)));
+        let _ = style.set_property("top", &format!("{}px", bounds.y() + f64::from(cursor.y)));
+        let input_type = if purpose == input_method::Purpose::Secure {
+            "password"
+        } else {
+            "text"
+        };
+        if self.element.type_() != input_type {
+            self.element.set_type(input_type);
+        }
+        // Never request the software keyboard from animation frames or startup.
+        // Only the IME of the settled, focused widget can consume a gesture.
+        if GESTURE.get() {
+            let options = FocusOptions::new();
+            options.set_prevent_scroll(true);
+            let _ = self.element.focus_with_options(&options);
+        }
+    }
+
+    pub fn disable(&mut self) {
+        if self.enabled {
+            self.enabled = false;
+            if self
+                .element
+                .owner_document()
+                .and_then(|document| document.active_element())
+                .as_ref()
+                == Some(self.element.as_ref())
+            {
+                let options = FocusOptions::new();
+                options.set_prevent_scroll(true);
+                let _ = self.canvas.focus_with_options(&options);
+            }
+            reset(&self.element);
+        }
+    }
+}
+
+impl Drop for Input {
+    fn drop(&mut self) {
+        self.listeners.clear();
+        self.element.remove();
+    }
+}
+
+fn reset(element: &HtmlInputElement) {
+    element.set_value(SENTINEL);
+    let _ = element.set_selection_range(1, 1);
+}
+
+fn keypress(canvas: &HtmlCanvasElement, key: &str) {
+    let init = KeyboardEventInit::new();
+    init.set_key(key);
+    init.set_code(key);
+    for name in ["keydown", "keyup"] {
+        if let Ok(event) = KeyboardEvent::new_with_keyboard_event_init_dict(name, &init) {
+            let _ = canvas.dispatch_event(&event);
+        }
+    }
+}
